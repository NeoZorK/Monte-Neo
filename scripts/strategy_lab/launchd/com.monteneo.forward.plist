<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.monteneo.forward</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__ROOT__/scripts/strategy_lab/forward_daily.sh</string><string>once</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <!-- every day 06:30 local; if the Mac was asleep, launchd runs it on wake; the script fills any missed day -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__ROOT__/strategy_lab/forward/launchd.out</string>
  <key>StandardErrorPath</key><string>__ROOT__/strategy_lab/forward/launchd.err</string>
</dict>
</plist>
