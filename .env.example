# Monte-Neo Environment Configuration

# Binance API (optional for public data / live OMS)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit API (optional live OMS)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Live OMS safety (default: live disabled; dry-run on when live enabled)
# MONTE_NEO_LIVE_TRADING=1
# MONTE_NEO_LIVE_DRY_RUN=1

# Data directory
MONTE_NEO_DATA_DIR=./data

# Logging
MONTE_NEO_LOG_LEVEL=INFO

# Parallel processing
MONTE_NEO_WORKERS=auto
