# Monte-Neo Environment Configuration

# Binance API (optional for public data / live OMS)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit API (optional live OMS)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Live OMS safety (default: live disabled; dry-run on when live enabled)
# MONTE_NEO_LIVE_TRADING=1
# MONTE_NEO_LIVE_DRY_RUN=1

# Data directory
MONTE_NEO_DATA_DIR=./data

# Logging
MONTE_NEO_LOG_LEVEL=INFO

# Parallel processing
MONTE_NEO_WORKERS=auto

# Research accelerator (optional)
# MONTE_NEO_RESEARCH_BYTES_BUDGET=
# MONTE_NEO_METAL_SHARED_BYTES_BUDGET=
# MONTE_NEO_METAL_MAX_BARS=
# Restore pre-0.17.5 research auto (prefer Metal when size-ok):
# MONTE_NEO_RESEARCH_AUTO_PREFER_METAL=1
# Allow auto→Metal only when n_combos >= N:
# MONTE_NEO_RESEARCH_AUTO_METAL_MIN_COMBOS=

