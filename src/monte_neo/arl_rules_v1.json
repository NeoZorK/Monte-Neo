{
 "schema": "arl-rules/1",
 "version": "arl-rules/1",
 "status": "provisional",
 "authorship": "The Alpha Readiness Level (ARL) was devised by Rostyslav Shcherbyna, author of Monte-Neo; it is modelled on the idea of a technology readiness level and is a Monte-Neo scale, not an industry standard.",
 "statuses": {
  "OK": [
   "pass",
   "info"
  ],
  "SOFT": [
   "pass",
   "info",
   "warn"
  ],
  "PASS": [
   "pass"
  ]
 },
 "levels": [
  {
   "level": 1,
   "name": "Idea on clean data",
   "requirements": [
    [
     [
      [
       "data_integrity",
       "SOFT"
      ]
     ],
     [
      [
       "ic",
       "SOFT"
      ]
     ]
    ]
   ],
   "how": "monte-neo verify or monte-neo alpha"
  },
  {
   "level": 2,
   "name": "The backtest is not broken",
   "requirements": [
    [
     [
      [
       "lookahead_truncation",
       "OK"
      ]
     ],
     [
      [
       "universe_lookahead",
       "SOFT"
      ]
     ]
    ]
   ],
   "how": "monte-neo verify --strategy (probes need code), or alpha with --membership"
  },
  {
   "level": 3,
   "name": "It earns after costs",
   "requirements": [
    [
     [
      [
       "net_profitability",
       "OK"
      ]
     ],
     [
      [
       "market_impact",
       "SOFT"
      ],
      [
       "cost_sensitivity",
       "SOFT"
      ]
     ]
    ]
   ],
   "how": "monte-neo verify, or monte-neo alpha --aum"
  },
  {
   "level": 4,
   "name": "The signal predicts",
   "requirements": [
    [
     [
      [
       "ic",
       "OK"
      ],
      [
       "signal_placebo",
       "OK"
      ]
     ],
     [
      [
       "timing_significance",
       "OK"
      ]
     ]
    ]
   ],
   "how": "monte-neo alpha (scores), or verify (timing test)"
  },
  {
   "level": 5,
   "name": "It is new alpha",
   "requirements": [
    [
     [
      [
       "residual_alpha",
       "OK"
      ],
      [
       "hidden_short_volatility",
       "OK"
      ]
     ]
    ]
   ],
   "how": "monte-neo alpha (attribution)"
  },
  {
   "level": 6,
   "name": "It survives the search",
   "requirements": [
    [
     [
      [
       "deflated_sharpe",
       "OK"
      ]
     ],
     [
      [
       "hlz_hurdle",
       "PASS"
      ],
      [
       "min_backtest_length",
       "SOFT"
      ]
     ]
    ]
   ],
   "how": "verify with --n-trials / --ledger, or alpha with --n-trials"
  },
  {
   "level": 7,
   "name": "Tradable and robust",
   "requirements": [
    [
     [
      [
       "market_impact",
       "SOFT"
      ]
     ],
     [
      [
       "capacity",
       "SOFT"
      ]
     ]
    ],
    [
     [
      [
       "synthetic_market_null",
       "OK"
      ],
      [
       "universe_subsampling",
       "SOFT"
      ],
      [
       "start_date_sensitivity",
       "OK"
      ]
     ],
     [
      [
       "period_consistency",
       "OK"
      ],
      [
       "delay_sensitivity",
       "OK"
      ]
     ]
    ],
    [
     [
      [
       "rebalance_timing_luck",
       "OK"
      ]
     ],
     [
      [
       "cost_margin",
       "OK"
      ]
     ]
    ]
   ],
   "how": "alpha with --aum (robustness runs by default), or verify with volume data"
  },
  {
   "level": 8,
   "name": "It adds to your book",
   "requirements": [
    [
     [
      [
       "marginal_sharpe",
       "OK"
      ]
     ]
    ]
   ],
   "how": "monte-neo alpha --book book.csv"
  },
  {
   "level": 9,
   "name": "Confirmed live",
   "requirements": [
    [
     [
      [
       "live_vs_backtest",
       "OK"
      ],
      [
       "alpha_death_monitor",
       "OK"
      ],
      [
       "live_source",
       "OK"
      ]
     ]
    ]
   ],
   "how": "monte-neo monitor --live live.csv --source real_fills --fills fills.csv (paper and testnet stop at 8)"
  }
 ],
 "caps": {
  "lookahead_fail_max_level": 1,
  "ceilings": [
   {
    "check": "survivorship",
    "max_level": 4,
    "why": "the universe may be today's survivors: declare the delisted names (delisted=...) or add their prices"
   }
  ],
  "blockers": [
   {
    "level": 5,
    "check": "alpha_after_beta",
    "why": "the return is not shown to be more than benchmark exposure"
   }
  ],
  "non_real_sources": {
   "sources": [
    "paper",
    "testnet",
    "simulated"
   ],
   "max_level": 8,
   "why": "paper, testnet and simulated fills are not live"
  }
 },
 "depth": {
  "max": 4,
  "criteria": [
   {
    "id": "D1",
    "name": "Margin",
    "text": "the level's main check passes by a clear margin, not at the threshold"
   },
   {
    "id": "D2",
    "name": "Breadth",
    "text": "the result repeats across independent slices (periods, assets, regimes, start dates)"
   },
   {
    "id": "D3",
    "name": "Sample",
    "text": "enough independent observations for the claim at this level"
   },
   {
    "id": "D4",
    "name": "Out of sample",
    "text": "the same level holds on data that did not choose the parameters (sealed holdout or forward data)"
   }
  ],
  "levels": {
   "1": {
    "D1": {
     "text": "no data warning at all (data_integrity and data_quality both pass)",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "status",
        "id": "data_integrity",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "status",
        "id": "data_quality",
        "allowed": [
         "pass"
        ]
       }
      ]
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger"
    },
    "D2": {
     "text": "two independent sources agree (data_source_replication)",
     "rule": {
      "type": "status",
      "id": "data_source_replication",
      "allowed": [
       "pass"
      ]
     },
     "needs": "monte-neo alpha --ohlcv prices.csv --scores scores.csv --aum A --n-trials N --replicate SOURCE2"
    },
    "D3": {
     "text": "at least 3 years of bars",
     "rule": {
      "type": "derived",
      "name": "years",
      "op": ">=",
      "value": 3
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger (more history)"
    },
    "D4": {
     "text": "a fresh fetch gives identical hashes",
     "rule": {
      "type": "evidence",
      "key": "fresh_fetch_hash"
     },
     "needs": "re-fetch the data and compare data_sha256 (monte-neo verify --recheck cert.json)"
    }
   },
   "2": {
    "D1": {
     "text": "all four probes pass (truncation, perturbation, static lint, repaint)",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "status",
        "id": "lookahead_truncation",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "status",
        "id": "lookahead_perturbation",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "status",
        "id": "lookahead_static_lint",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "status",
        "id": "repaint_history",
        "allowed": [
         "pass"
        ]
       }
      ]
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger (strategy code and source are required)"
    },
    "D2": {
     "text": "probes pass at many cut points (at least 12 in truncation and perturbation)",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "detail",
        "id": "lookahead_truncation",
        "key": "checkpoints",
        "op": ">=",
        "value": 12
       },
       {
        "type": "detail",
        "id": "lookahead_perturbation",
        "key": "checkpoints",
        "op": ">=",
        "value": 12
       },
       {
        "type": "status",
        "id": "lookahead_truncation",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "status",
        "id": "lookahead_perturbation",
        "allowed": [
         "pass"
        ]
       }
      ]
     },
     "needs": "monte-neo verify --probe-checks 24"
    },
    "D3": {
     "text": "at least 20 cut points",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "detail",
        "id": "lookahead_truncation",
        "key": "checkpoints",
        "op": ">=",
        "value": 20
       },
       {
        "type": "status",
        "id": "lookahead_truncation",
        "allowed": [
         "pass"
        ]
       }
      ]
     },
     "needs": "monte-neo verify --probe-checks 24"
    },
    "D4": {
     "text": "probes pass again on the sealed holdout",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "holdout_valid"
       },
       {
        "type": "all",
        "of": [
         {
          "type": "status",
          "id": "lookahead_truncation",
          "allowed": [
           "pass"
          ]
         },
         {
          "type": "status",
          "id": "lookahead_perturbation",
          "allowed": [
           "pass"
          ]
         }
        ],
        "holdout": true
       }
      ]
     },
     "needs": "freeze and open the sealed holdout once (SealedHoldout), then monte-neo readiness --holdout .monte-neo/sealed_holdout.jsonl"
    }
   },
   "3": {
    "D1": {
     "text": "break-even cost at least 5x the modelled cost",
     "rule": {
      "type": "ratio",
      "a": {
       "id": "cost_margin",
       "key": "breakeven_bps"
      },
      "b": {
       "id": "costs_modeled",
       "key": "per_side_cost_bps"
      },
      "op": ">=",
      "value": 5
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger",
     "repair": "cost_margin"
    },
    "D2": {
     "text": "profitable in at least 5 of 6 equal periods (walk-forward windows)",
     "rule": {
      "type": "ratio",
      "a": {
       "id": "walk_forward_stability",
       "key": "positive"
      },
      "b": {
       "id": "walk_forward_stability",
       "key": "windows"
      },
      "op": ">=",
      "value": 0.8333333333333334
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger",
     "repair": "net_profitability"
    },
    "D3": {
     "text": "at least 100 closed trades",
     "rule": {
      "type": "detail",
      "id": "sample_size",
      "key": "n_closed_trades",
      "op": ">=",
      "value": 100
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger (more history or instruments)"
    },
    "D4": {
     "text": "net positive on the sealed holdout",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "holdout_valid"
       },
       {
        "type": "status",
        "id": "net_profitability",
        "allowed": [
         "pass"
        ],
        "holdout": true
       }
      ]
     },
     "needs": "freeze and open the sealed holdout once (SealedHoldout), then monte-neo readiness --holdout .monte-neo/sealed_holdout.jsonl"
    }
   },
   "4": {
    "D1": {
     "text": "permutation / placebo p below 0.01 after paying for all project trials (p x n_trials)",
     "rule": {
      "type": "any",
      "of": [
       {
        "type": "pvalue",
        "id": "signal_placebo",
        "key": "p_value",
        "max": 0.01,
        "trials": true
       },
       {
        "type": "pvalue",
        "id": "timing_significance",
        "key": "p_value",
        "max": 0.01,
        "trials": true
       }
      ]
     },
     "needs": "monte-neo alpha --ohlcv prices.csv --scores scores.csv --aum A --n-trials N"
    },
    "D2": {
     "text": "positive in at least 70 % of periods or assets",
     "rule": {
      "type": "any",
      "of": [
       {
        "type": "detail",
        "id": "universe_subsampling",
        "key": "share_positive",
        "op": ">=",
        "value": 0.7
       },
       {
        "type": "ratio",
        "a": {
         "id": "walk_forward_stability",
         "key": "positive"
        },
        "b": {
         "id": "walk_forward_stability",
         "key": "windows"
        },
        "op": ">=",
        "value": 0.7
       }
      ]
     },
     "needs": "monte-neo alpha --ohlcv prices.csv --scores scores.csv --aum A --n-trials N"
    },
    "D3": {
     "text": "at least 1,000 observations",
     "rule": {
      "type": "derived",
      "name": "observations",
      "op": ">=",
      "value": 1000
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger (more history)"
    },
    "D4": {
     "text": "significant on the sealed holdout",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "holdout_valid"
       },
       {
        "type": "any",
        "of": [
         {
          "type": "status",
          "id": "timing_significance",
          "allowed": [
           "pass"
          ]
         },
         {
          "type": "status",
          "id": "signal_placebo",
          "allowed": [
           "pass"
          ]
         }
        ],
        "holdout": true
       }
      ]
     },
     "needs": "freeze and open the sealed holdout once (SealedHoldout), then monte-neo readiness --holdout .monte-neo/sealed_holdout.jsonl"
    }
   },
   "5": {
    "D1": {
     "text": "residual alpha t-statistic at least 3, after paying for all project trials",
     "rule": {
      "type": "tstat",
      "id": "residual_alpha",
      "key": "alpha_t",
      "min_t": 3,
      "trials": true
     },
     "needs": "monte-neo alpha --ohlcv prices.csv --scores scores.csv --aum A --n-trials N"
    },
    "D2": {
     "text": "alpha survives all factors including the market beta",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "status",
        "id": "residual_alpha",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "status",
        "id": "alpha_after_beta",
        "allowed": [
         "pass"
        ],
        "optional": true
       }
      ]
     },
     "needs": "monte-neo alpha --ohlcv prices.csv --scores scores.csv --aum A --n-trials N",
     "repair": "alpha_after_beta"
    },
    "D3": {
     "text": "at least 5 years",
     "rule": {
      "type": "derived",
      "name": "years",
      "op": ">=",
      "value": 5
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger (more history)"
    },
    "D4": {
     "text": "residual alpha positive on the sealed holdout",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "holdout_valid"
       },
       {
        "type": "any",
        "of": [
         {
          "type": "status",
          "id": "residual_alpha",
          "allowed": [
           "pass"
          ]
         },
         {
          "type": "status",
          "id": "alpha_after_beta",
          "allowed": [
           "pass"
          ]
         }
        ],
        "holdout": true
       }
      ]
     },
     "needs": "freeze and open the sealed holdout once (SealedHoldout), then monte-neo readiness --holdout .monte-neo/sealed_holdout.jsonl"
    }
   },
   "6": {
    "D1": {
     "text": "Deflated Sharpe at least 0.99 with the project's full trial count",
     "rule": {
      "type": "detail",
      "id": "deflated_sharpe",
      "key": "deflated_sharpe",
      "op": ">=",
      "value": 0.99,
      "trials_key": "n_trials",
      "trials": true
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger"
    },
    "D2": {
     "text": "probability of backtest overfitting below 0.2",
     "rule": {
      "type": "detail",
      "id": "pbo",
      "key": "pbo",
      "op": "<",
      "value": 0.2
     },
     "needs": "monte-neo verify --grid grid.json"
    },
    "D3": {
     "text": "trial count audited in the ledger and not below the real count",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "status",
        "id": "trial_ledger",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "trials_declared"
       }
      ]
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger"
    },
    "D4": {
     "text": "holdout opened once after freeze, Deflated Sharpe at least 0.95 there",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "holdout_valid"
       },
       {
        "type": "detail",
        "id": "deflated_sharpe",
        "key": "deflated_sharpe",
        "op": ">=",
        "value": 0.95,
        "holdout": true
       }
      ]
     },
     "needs": "freeze and open the sealed holdout once (SealedHoldout), then monte-neo readiness --holdout .monte-neo/sealed_holdout.jsonl"
    }
   },
   "7": {
    "D1": {
     "text": "net positive at 2x costs and a 1-bar delay",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "status",
        "id": "cost_sensitivity",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "status",
        "id": "delay_sensitivity",
        "allowed": [
         "pass"
        ]
       }
      ]
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger",
     "repair": "cost_sensitivity"
    },
    "D2": {
     "text": "worst of regimes, rebalance phases (and subsamples, start dates when run) still passes",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "status",
        "id": "regime_stability",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "status",
        "id": "rebalance_timing_luck",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "status",
        "id": "universe_subsampling",
        "allowed": [
         "pass"
        ],
        "optional": true
       },
       {
        "type": "status",
        "id": "start_date_sensitivity",
        "allowed": [
         "pass"
        ],
        "optional": true
       }
      ]
     },
     "needs": "monte-neo verify --ohlcv data.csv --strategy s.py --n-trials N --ledger",
     "repair": "rebalance_timing_luck"
    },
    "D3": {
     "text": "capacity at least 10x the planned capital",
     "rule": {
      "type": "ratio",
      "a": {
       "id": "capacity_curve",
       "key": "aum_half"
      },
      "b": {
       "id": "market_impact",
       "key": "aum"
      },
      "op": ">=",
      "value": 10
     },
     "needs": "monte-neo alpha --ohlcv prices.csv --scores scores.csv --aum A --n-trials N"
    },
    "D4": {
     "text": "survives the sealed holdout under realistic fills (net positive, cost_realism passes)",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "holdout_valid"
       },
       {
        "type": "all",
        "of": [
         {
          "type": "status",
          "id": "net_profitability",
          "allowed": [
           "pass"
          ]
         },
         {
          "type": "status",
          "id": "cost_realism",
          "allowed": [
           "pass"
          ]
         }
        ],
        "holdout": true
       }
      ]
     },
     "needs": "freeze and open the sealed holdout once (SealedHoldout), then monte-neo readiness --holdout .monte-neo/sealed_holdout.jsonl"
    }
   },
   "8": {
    "D1": {
     "text": "marginal Sharpe interval excludes 0",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "status",
        "id": "marginal_sharpe",
        "allowed": [
         "pass"
        ]
       },
       {
        "type": "detail",
        "id": "marginal_sharpe",
        "key": "gain_ci90.0",
        "op": ">",
        "value": 0
       }
      ]
     },
     "needs": "monte-neo alpha ... --book book.csv"
    },
    "D2": {
     "text": "positive across sub-periods and stress",
     "rule": {
      "type": "evidence",
      "key": "book_stress"
     },
     "needs": "monte-neo alpha ... --book book.csv --stress"
    },
    "D3": {
     "text": "at least 3 years overlapping the book",
     "rule": {
      "type": "derived",
      "name": "years",
      "op": ">=",
      "value": 3
     },
     "needs": "monte-neo alpha ... --book book.csv"
    },
    "D4": {
     "text": "positive on forward data",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "holdout_valid"
       },
       {
        "type": "status",
        "id": "marginal_sharpe",
        "allowed": [
         "pass"
        ],
        "holdout": true
       }
      ]
     },
     "needs": "freeze and open the sealed holdout once (SealedHoldout), then monte-neo readiness --holdout .monte-neo/sealed_holdout.jsonl"
    }
   },
   "9": {
    "D1": {
     "text": "live Sharpe inside the backtest confidence interval",
     "rule": {
      "type": "between",
      "value": "live.live_sharpe_annualized",
      "lo": "cert.sharpe_ci95.0",
      "hi": "cert.sharpe_ci95.1"
     },
     "needs": "monte-neo monitor --certificate cert.json --live live.csv --fills fills.csv --source real_fills --custody STATEMENT"
