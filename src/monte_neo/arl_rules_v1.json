     "rule": {
      "type": "evidence",
      "key": "live_regimes"
     },
     "needs": "monte-neo monitor --certificate cert.json --live live.csv --fills fills.csv --source real_fills --custody STATEMENT (a live period that spans a rising and a falling market)"
    },
    "D3": {
     "text": "at least 6 months and 100 fills live",
     "rule": {
      "type": "all",
      "of": [
       {
        "type": "derived",
        "name": "live_span_days",
        "op": ">=",
        "value": 182
       },
       {
        "type": "derived",
        "name": "live_fills",
        "op": ">=",
        "value": 100
